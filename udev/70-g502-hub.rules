# Give the logged-in user access to the Logitech G502's HID++ channel,
# so g502-hub can configure the mouse without root.
# G502 HERO and G502 LIGHTSPEED on a cable
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c08b|c08d", TAG+="uaccess"
# LIGHTSPEED receivers (the mouse's own node hangs off the receiver's USB device)
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c539|c53a|c53d|c53f|c541|c545|c547|c54d", TAG+="uaccess"
# Let it create the virtual keyboard that plays macros run by the app
# (the same rule Steam ships for its controllers).
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
